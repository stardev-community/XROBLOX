		-- RESIZE: drag pojok kanan bawah untuk resize window
		ResizeHandle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local startMouse = UserInputService:GetMouseLocation()
				local startW = Background.AbsoluteSize.X
				local startH = Background.AbsoluteSize.Y
				local rsConn
				rsConn = RunService:BindToRenderStep("resize", 1, function()
					local cur = UserInputService:GetMouseLocation()
					local newW = math.max(280, startW + (cur.X - startMouse.X))
					local newH = math.max(180, startH + (cur.Y - startMouse.Y))
					Background.Size = UDim2.fromOffset(newW, newH)
					if sideClosed then minimizeSize(0.01) else maximizeSize(0.01) end
					ResizeHandle.Position = UDim2.new(1, -14, 1, -14)
				end)
				local endConn
				endConn = UserInputService.InputEnded:Connect(function(ie)
					if ie.UserInputType == Enum.UserInputType.MouseButton1 then
						RunService:UnbindFromRenderStep("resize")
						endConn:Disconnect()
					end
				end)
				table.insert(connections, endConn)
			end
		end)
		table.insert(connections, UserInputService.InputBegan:Connect(backgroundUserInput))
		connectResize()
		SimpleSpy2.Enabled = true
		coroutine.wrap(function() wait(1); onToggleButtonUnhover() end)()
		schedulerconnect = RunService.Heartbeat:Connect(taskscheduler)
		if syn and syn.protect_gui then pcall(syn.protect_gui, SimpleSpy2) end
		bringBackOnResize()
		SimpleSpy2.Parent = CoreGui
		_G.SimpleSpyExecuted = true
		if not Players.LocalPlayer then
			Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
		end
		Mouse = Players.LocalPlayer:GetMouse()
		oldIcon = Mouse.Icon
		table.insert(connections, Mouse.Move:Connect(mouseMoved))
	end)
	if not succeeded then
		warn("A fatal error has occured, SimpleSpy was unable to launch properly.\n" .. tostring(err))
		SimpleSpy2:Destroy()
		hookfunction(remoteEvent.FireServer, originalEvent)
		hookfunction(remoteFunction.InvokeServer, originalFunction)
		if hookmetamethod then
			if original then hookmetamethod(game, "__namecall", original) end
		else
			setreadonly(gm, false)
			gm.__namecall = original
			setreadonly(gm, true)
		end
		return
	end
else
	SimpleSpy2:Destroy()
	return
end

---------------------------------------------------------------------
-- OnClientEvent spy
---------------------------------------------------------------------
local clientEventConnections = {}

local function hookOnClientEvent(remote)
	if not pcall(function() return remote:IsA("RemoteEvent") end) then return end
	if not remote:IsA("RemoteEvent") then return end
	if clientEventConnections[remote] then return end
	local ok, conn = pcall(function()
		return remote.OnClientEvent:Connect(function(...)
			if not toggle then return end
			local args = { ... }
			local remoteName = ""
			pcall(function() remoteName = remote.Name end)
			if blacklist[remote] or blacklist[remoteName] then return end
			if blocklist[remote] or blocklist[remoteName] then return end
			local rpath = ""; pcall(function() rpath = i2p(remote) end)
			if rpath ~= "" and blocklist[rpath] then return end
			newRemote("clientevent", remoteName, args, remote, nil, false, nil)
		end)
	end)
	if ok and conn then clientEventConnections[remote] = conn end
end

local function disconnectClientHook(remote)
	if clientEventConnections[remote] then
		pcall(function() clientEventConnections[remote]:Disconnect() end)
		clientEventConnections[remote] = nil
	end
end

local function scanAllRemotes()
	pcall(function()
		for _, v in pairs(game:GetDescendants()) do
			if pcall(function() return v:IsA("RemoteEvent") end) and v:IsA("RemoteEvent") then
				hookOnClientEvent(v)
			end
		end
	end)
end

game.DescendantAdded:Connect(function(v)
	pcall(function()
		if v:IsA("RemoteEvent") then task.wait(0.05); hookOnClientEvent(v) end
	end)
end)

task.delay(1, scanAllRemotes)

